pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/jenkins-docs/simple-java-maven-app.git'
            }
        }

        stage('Build') {
            steps {
                bat '"C:\\apache-maven-3.10.1\\bin\\mvn.cmd" clean compile'
            }
        }

        stage('Test') {
            steps {
                bat '"C:\\apache-maven-3.10.1\\bin\\mvn.cmd" test'
            }
        }

        stage('Package') {
            steps {
                bat '"C:\\apache-maven-3.10.1\\bin\\mvn.cmd" package'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                if not exist deploy mkdir deploy
                copy target\\*.jar deploy\\
                '''
            }
        }
    }
}
